# Equalizer
msgid "{} Hz"
msgstr "{} Гц"

msgid "{} kHz"
msgstr "{} кГц"

msgid "{}, dB"
msgstr "{}, дБ"

msgid "Equalizer bands: {}"
msgstr "Смуги еквалайзера: {}"

msgid "Equalizer curve. Drag to adjust a frequency, or use the sliders below."
msgstr "Крива еквалайзера. Перетягніть, щоб змінити частоту, або скористайтеся повзунками нижче."

msgid "This device only supports the built-in equalizer profiles."
msgstr "Ця модель підтримує лише вбудовані профілі еквалайзера."

msgid "Values in decibels, from {} to {} dB"
msgstr "Значення в децибелах, від {} до {} дБ"

msgid "Save profile"
msgstr "Зберегти профіль"

msgid "All profiles ({})"
msgstr "Усі профілі ({})"

msgid "Show fewer"
msgstr "Згорнути"

msgid "Equalizer values are unavailable for this device."
msgstr "Значення еквалайзера для цього пристрою недоступні."

msgid "Changing the equalizer turns off spatial audio."
msgstr "Зміна еквалайзера вимикає просторовий звук."

msgid "Drag the points on the chart, move the sliders with ↑ ↓ or type the values."
msgstr "Перетягуйте точки на графіку, рухайте повзунки клавішами ↑ ↓ або вводьте значення."

msgid "My profiles"
msgstr "Мої профілі"

msgid "Save the current sound to come back to it later."
msgstr "Збережіть поточний звук, щоб повернутися до нього пізніше."

msgid "Applied"
msgstr "Застосовано"

msgid "Bands: {}"
msgstr "Смуг: {}"

msgid "More for “{}”"
msgstr "Ще для «{}»"

msgid "Export"
msgstr "Експорт"

msgid "Delete"
