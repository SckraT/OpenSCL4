# Slogans and descriptions, as in the Android app
msgid "Hear what matters."
msgstr "大切な音を聴こう。"

msgid "Your sound, your way."
msgstr "あなたらしいサウンドを。"

msgid "Inside the sound."
msgstr "音の中へ。"

msgid "One preset. Your settings."
msgstr "ひとつのプリセットに、あなたの設定を。"

msgid "A touch. And you’re in control."
msgstr "ワンタッチで思いのままに。"

msgid "Comfortable listening. Every day."
msgstr "毎日、快適なリスニングを。"

msgid "Always ready."
msgstr "いつでも準備万端。"

msgid "Stay connected. To two at once."
msgstr "2台同時につながる。"

msgid "A little case. More possibilities."
msgstr "小さなケースに、もっと多くの可能性を。"

msgid "All about your device."
msgstr "デバイスのすべて。"

msgid "Your devices."
msgstr "あなたのデバイス。"

msgid "Make it yours."
msgstr "お好みのままに。"

msgid "Choose how much of the world to let into your sound."
msgstr "周囲の音をどれだけ取り込むかを選びます。"

msgid "Pick a profile or tune every frequency."
msgstr "プロファイルを選ぶか、各周波数を調整します。"

msgid "Codec, latency and how the sound is processed."
msgstr "コーデック、遅延、音の処理方法。"

msgid "Save your favourite combinations and return to them with a click."
msgstr "お気に入りの組み合わせを保存して、クリックひとつで呼び出せます。"

msgid "What presses do, and which modes they switch between."
msgstr "タップの動作と、切り替えるモードを設定します。"

msgid "Settings that adapt your earbuds to your habits."
msgstr "イヤホンをあなたの習慣に合わせる設定です。"

msgid "Settings that adapt your speaker to your habits."
msgstr "スピーカーをあなたの習慣に合わせる設定です。"

msgid "When the device turns off and what it tells you."
msgstr "デバイスの電源が切れるタイミングと音声ガイド。"

msgid "Switch between your phone and computer."
msgstr "スマートフォンとコンピューターを切り替えます。"

msgid "The case screen’s features and how the case is doing."
msgstr "ケース画面の機能とケースの状態。"

msgid "Battery, firmware and serial numbers."
msgstr "バッテリー、ファームウェア、シリアル番号。"

msgid "All your familiar headphones in one place."
msgstr "おなじみのヘッドホンをひとつの場所に。"

msgid "An app that feels comfortable to use."
msgstr "使いやすいアプリ。"

# Connection
msgid "No devices"
msgstr "デバイスがありません"

msgid "Add a device"
msgstr "デバイスを追加"

msgid "Connected"
msgstr "接続済み"

msgid "Connecting…"
msgstr "接続中…"

msgid "Not connected"
msgstr "未接続"

msgid "Connected to {}"
msgstr "{} に接続済み"

msgid "Connecting to {}"
msgstr "{} に接続中"

msgid "Connection lost"
msgstr "接続が切れました"

msgid "Bluetooth is off"
msgstr "Bluetooth がオフです"

msgid "Disconnected"
msgstr "切断しました"

msgid "Connecting to your headphones"
msgstr "ヘッドホンに接続しています"

msgid "Connecting to your speaker"
msgstr "スピーカーに接続しています"

msgid "Could not connect"
msgstr "接続できませんでした"

msgid "{} is not connected"
msgstr "{} は接続されていません"

msgid "Open the case or turn on your headphones. Controls will appear once connected."
msgstr "ケースを開けるか、ヘッドホンの電源を入れてください。接続すると操作項目が表示されます。"

msgid "Turn on your speaker. Controls will appear once connected."
msgstr "スピーカーの電源を入れてください。接続すると操作項目が表示されます。"

msgid "Check that your headphones are nearby and connected to this computer by Bluetooth."
msgstr "ヘッドホンが近くにあり、このコンピューターに Bluetooth で接続されているか確認してください。"

msgid "Check that your speaker is nearby and connected to this computer by Bluetooth."
msgstr "スピーカーが近くにあり、このコンピューターに Bluetooth で接続されているか確認してください。"

msgid "Turn on Bluetooth in Windows settings, then try connecting again."
msgstr "Windows の設定で Bluetooth をオンにしてから、もう一度接続してください。"

msgid "Connect to see battery levels and change settings."
msgstr "接続するとバッテリー残量の確認や設定の変更ができます。"

msgid "The device was not found. Make sure it is turned on and nearby."
msgstr "デバイスが見つかりません。電源が入っていて近くにあるか確認してください。"

msgid "The device did not answer in time. Try again."
msgstr "デバイスが時間内に応答しませんでした。もう一度お試しください。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Connect"
msgstr "接続"

msgid "Connect again"
msgstr "再接続"

msgid "Bluetooth settings"
msgstr "Bluetooth の設定"

msgid "Could not change “{}”. The device kept its previous value."
msgstr "「{}」を変更できませんでした。デバイスは以前の値のままです。"

msgid "Retry"
msgstr "再試行"

msgid "Close"
msgstr "閉じる"

# My devices
msgid "Open"
msgstr "開く"

msgid "Forget device"
msgstr "デバイスを削除"

msgid "Demo device · Not connected"
msgstr "デモデバイス · 未接続"

msgid "Saved device · Not connected"
msgstr "保存済みのデバイス · 未接続"

msgid "Add device"
msgstr "デバイスを追加"

msgid "A model, then its paired device"
msgstr "モデルを選び、ペアリング済みのデバイスを選択"

msgid "Your sound starts here."
msgstr "あなたのサウンドはここから。"

msgid "Add your headphones to adjust sound and controls."
msgstr "ヘッドホンを追加して、サウンドと操作を調整しましょう。"

msgid "Forget {}?"
msgstr "{} を削除しますか？"

msgid "The device leaves this list together with its profiles and presets in the app. Its pairing with Windows stays."
msgstr "このデバイスは、アプリ内のプロファイルやプリセットとともにこの一覧から削除されます。Windows とのペアリングはそのままです。"

msgid "Forget"
msgstr "削除"

# Adding a device
msgid "Find your model."
msgstr "モデルを探しましょう。"

msgid "Choose the exact model so you see the controls your device supports."
msgstr "正確なモデルを選ぶと、デバイスが対応する設定が表示されます。"

msgid "Model name or code, such as A3954"
msgstr "モデル名またはコード（例: A3954）"

msgid "All"
msgstr "すべて"

msgid "Earbuds"
msgstr "イヤホン"

msgid "Over-ear"
msgstr "オーバーイヤー"

msgid "Open-ear"
msgstr "オープンイヤー"

msgid "Speakers"
msgstr "スピーカー"

msgid "No models found. Try another name or code."
msgstr "モデルが見つかりません。別の名前かコードをお試しください。"

msgid "Ready to connect your headphones?"
msgstr "ヘッドホンを接続しますか？"

msgid "Ready to connect your speaker?"
msgstr "スピーカーを接続しますか？"

msgid "Choose the device paired with Windows. If it is not listed, pair it in Bluetooth settings first."
msgstr "Windows とペアリング済みのデバイスを選んでください。一覧にない場合は、先に Bluetooth の設定でペアリングしてください。"

msgid "Another model"
msgstr "別のモデル"

msgid "Demo mode"
msgstr "デモモード"

msgid "Explore the interface without real headphones"
msgstr "実機なしでインターフェースを試せます"

msgid "Paired devices"
msgstr "ペアリング済みのデバイス"

msgid "Refresh"
msgstr "更新"

msgid "Bluetooth is off. Turn it on in Windows settings."
msgstr "Bluetooth がオフです。Windows の設定でオンにしてください。"

msgid "Looking for paired devices…"
msgstr "ペアリング済みのデバイスを探しています…"

msgid "Make sure your headphones are turned on and paired with Windows, then refresh."
msgstr "ヘッドホンの電源が入っていて Windows とペアリングされているか確認してから、更新してください。"

msgid "Simulated device data"
msgstr "シミュレーションのデバイスデータ"

msgid "Paired in Windows · looks like the chosen model"
msgstr "Windows でペアリング済み · 選んだモデルと思われます"

msgid "Paired in Windows"
msgstr "Windows でペアリング済み"

msgid "Could not add the device."
msgstr "デバイスを追加できませんでした。"

msgid "Demo mode uses simulated device data and does not control real headphones."
msgstr "デモモードはシミュレーションのデータを使い、実際のヘッドホンは操作しません。"

msgid "Back"
msgstr "戻る"

# Section pages
msgid "Mode and strength"
msgstr "モードと強さ"

msgid "Sound mode from 1 to 11"
msgstr "1〜11 のサウンドモード"

msgid "Transparency, strength {}"
msgstr "外音取り込み、強さ {}"

