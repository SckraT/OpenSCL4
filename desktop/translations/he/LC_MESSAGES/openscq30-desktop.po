# Slogans and descriptions, as in the Android app
msgid "Hear what matters."
msgstr "לשמוע את מה שחשוב."

msgid "Your sound, your way."
msgstr "הצליל שלך, בדרך שלך."

msgid "Inside the sound."
msgstr "בתוך הצליל."

msgid "One preset. Your settings."
msgstr "הגדרה אחת. ההעדפות שלך."

msgid "A touch. And you’re in control."
msgstr "נגיעה אחת. והשליטה בידיים שלך."

msgid "Comfortable listening. Every day."
msgstr "האזנה נוחה. בכל יום."

msgid "Always ready."
msgstr "תמיד מוכן."

msgid "Stay connected. To two at once."
msgstr "להישאר מחובר. לשניים בבת אחת."

msgid "A little case. More possibilities."
msgstr "קייס קטן. יותר אפשרויות."

msgid "All about your device."
msgstr "הכול על המכשיר שלך."

msgid "Your devices."
msgstr "המכשירים שלך."

msgid "Make it yours."
msgstr "בדיוק לטעמך."

msgid "Choose how much of the world to let into your sound."
msgstr "בחר כמה מהעולם להכניס לצליל שלך."

msgid "Pick a profile or tune every frequency."
msgstr "בחר פרופיל או כוונן כל תדר."

msgid "Codec, latency and how the sound is processed."
msgstr "קודק, השהיה ואופן עיבוד הצליל."

msgid "Save your favourite combinations and return to them with a click."
msgstr "שמור את השילובים האהובים עליך וחזור אליהם בלחיצה."

msgid "What presses do, and which modes they switch between."
msgstr "מה עושות הנגיעות ובין אילו מצבים הן מחליפות."

msgid "Settings that adapt your earbuds to your habits."
msgstr "הגדרות שמתאימות את האוזניות להרגלים שלך."

msgid "Settings that adapt your speaker to your habits."
msgstr "הגדרות שמתאימות את הרמקול להרגלים שלך."

msgid "When the device turns off and what it tells you."
msgstr "מתי המכשיר נכבה ומה הוא מודיע לך."

msgid "Switch between your phone and computer."
msgstr "מעבר בין הטלפון למחשב."

msgid "The case screen’s features and how the case is doing."
msgstr "הפונקציות של מסך הקייס ומצב הקייס."

msgid "Battery, firmware and serial numbers."
msgstr "סוללה, קושחה ומספרים סידוריים."

msgid "All your familiar headphones in one place."
msgstr "כל האוזניות המוכרות שלך במקום אחד."

msgid "An app that feels comfortable to use."
msgstr "אפליקציה נוחה לשימוש."

# Connection
msgid "No devices"
msgstr "אין מכשירים"

msgid "Add a device"
msgstr "הוסף מכשיר"

msgid "Connected"
msgstr "מחובר"

msgid "Connecting…"
msgstr "מתחבר…"

msgid "Not connected"
msgstr "לא מחובר"

msgid "Connected to {}"
msgstr "מחובר אל {}"

msgid "Connecting to {}"
msgstr "מתחבר אל {}"

msgid "Reconnecting:"
msgstr "מתחבר מחדש:"

msgid "Reconnecting to {}"
msgstr "מתחבר מחדש ל-{}"

msgid "The device is still nearby. Settings will return when it reconnects."
msgstr "המכשיר עדיין בקרבת מקום. ההגדרות יחזרו כשהוא יתחבר מחדש."

msgid "changes are paused until the device is back."
msgstr "השינויים מושהים עד שהמכשיר יחזור."

msgid "Connection lost"
msgstr "החיבור אבד"

msgid "Bluetooth is off"
msgstr "ה-Bluetooth כבוי"

msgid "Disconnected"
msgstr "מנותק"

msgid "Connecting to your headphones"
msgstr "מתחבר לאוזניות"

msgid "Connecting to your speaker"
msgstr "מתחבר לרמקול"

msgid "Could not connect"
msgstr "לא ניתן להתחבר"

msgid "{} is not connected"
msgstr "{} לא מחובר"

msgid "Open the case or turn on your headphones. Controls will appear once connected."
msgstr "פתח את הקייס או הדלק את האוזניות. הפקדים יופיעו לאחר החיבור."

msgid "Turn on your speaker. Controls will appear once connected."
msgstr "הדלק את הרמקול. הפקדים יופיעו לאחר החיבור."

msgid "Check that your headphones are nearby and connected to this computer by Bluetooth."
msgstr "ודא שהאוזניות בקרבת מקום ומחוברות למחשב הזה ב-Bluetooth."

msgid "Check that your speaker is nearby and connected to this computer by Bluetooth."
msgstr "ודא שהרמקול בקרבת מקום ומחובר למחשב הזה ב-Bluetooth."

msgid "Turn on Bluetooth in Windows settings, then try connecting again."
msgstr "הפעל Bluetooth בהגדרות Windows ונסה להתחבר שוב."

msgid "Turn on Bluetooth in the system settings, then try connecting again."
msgstr "הפעל Bluetooth בהגדרות המערכת ונסה להתחבר שוב."

msgid "Connect to see battery levels and change settings."
msgstr "התחבר כדי לראות את הסוללה ולשנות הגדרות."

msgid "The device was not found. Make sure it is turned on and nearby."
msgstr "המכשיר לא נמצא. ודא שהוא דולק וקרוב."

msgid "The device did not answer in time. Try again."
msgstr "המכשיר לא ענה בזמן. נסה שוב."

msgid "Cancel"
msgstr "ביטול"

msgid "Connect"
msgstr "התחבר"

msgid "Connect again"
msgstr "התחבר שוב"

msgid "Bluetooth settings"
msgstr "הגדרות Bluetooth"

msgid "Could not change “{}”. The device kept its previous value."
msgstr "לא ניתן לשנות את „{}”. המכשיר שמר על הערך הקודם."

msgid "Retry"
msgstr "נסה שוב"

msgid "Close"
msgstr "סגור"

# My devices
msgid "Open"
msgstr "פתח"

msgid "Forget device"
msgstr "שכח מכשיר"

msgid "Demo device · Not connected"
msgstr "מכשיר הדגמה · לא מחובר"

msgid "Saved device · Not connected"
msgstr "מכשיר שמור · לא מחובר"

msgid "Add device"
msgstr "הוסף מכשיר"

msgid "A model, then its paired device"
msgstr "דגם, ואז המכשיר המותאם שלו"

msgid "Your sound starts here."
msgstr "הצליל שלך מתחיל כאן."

msgid "Add your headphones to adjust sound and controls."
msgstr "הוסף את האוזניות כדי לכוונן צליל ופקדים."

msgid "Forget {}?"
msgstr "לשכוח את {}?"

msgid "The device leaves this list together with its profiles and presets in the app. Its pairing with Windows stays."
msgstr "המכשיר יוסר מהרשימה יחד עם הפרופילים וההגדרות שלו באפליקציה. ההתאמה ל-Windows נשארת."

msgid "The device leaves this list together with its profiles and presets in the app. Its pairing with this computer stays."
msgstr "המכשיר יוסר מהרשימה יחד עם הפרופילים וההגדרות שלו באפליקציה. ההתאמה למחשב הזה נשארת."

msgid "Forget"
msgstr "שכח"

# Adding a device
msgid "Find your model."
msgstr "מצא את הדגם שלך."

msgid "Choose the exact model so you see the controls your device supports."
msgstr "בחר את הדגם המדויק כדי לראות את ההגדרות שהמכשיר שלך תומך בהן."

msgid "Model name or code, such as A3954"
msgstr "שם או קוד דגם, למשל A3954"

msgid "All"
msgstr "הכול"

msgid "Earbuds"
msgstr "אוזניות תוך-אוזן"

msgid "Over-ear"
msgstr "אוזניות מעל האוזן"

msgid "Open-ear"
msgstr "אוזניות פתוחות"

msgid "Speakers"
msgstr "רמקולים"

msgid "No models found. Try another name or code."
msgstr "לא נמצאו דגמים. נסה שם או קוד אחר."

msgid "Ready to connect your headphones?"
msgstr "מוכן לחבר את האוזניות?"

msgid "Ready to connect your speaker?"
msgstr "מוכן לחבר את הרמקול?"

msgid "Choose the device paired with Windows. If it is not listed, pair it in Bluetooth settings first."
msgstr "בחר את המכשיר שמותאם ל-Windows. אם הוא לא ברשימה, התאם אותו קודם בהגדרות Bluetooth."

msgid "Choose the device paired with this computer. If it is not listed, pair it in Bluetooth settings first."
msgstr "בחר את המכשיר שמותאם למחשב הזה. אם הוא לא ברשימה, התאם אותו קודם בהגדרות Bluetooth."

msgid "Another model"
msgstr "דגם אחר"

msgid "Demo mode"
msgstr "מצב הדגמה"

msgid "Explore the interface without real headphones"
msgstr "לחקור את הממשק בלי אוזניות אמיתיות"

msgid "Paired devices"
msgstr "מכשירים מותאמים"

msgid "Refresh"
msgstr "רענן"

msgid "Bluetooth is off. Turn it on in Windows settings."
msgstr "ה-Bluetooth כבוי. הפעל אותו בהגדרות Windows."

msgid "Bluetooth is off. Turn it on in the system settings."
msgstr "ה-Bluetooth כבוי. הפעל אותו בהגדרות המערכת."

msgid "Looking for paired devices…"
msgstr "מחפש מכשירים מותאמים…"

msgid "Make sure your headphones are turned on and paired with Windows, then refresh."
msgstr "ודא שהאוזניות דולקות ומותאמות ל-Windows, ואז רענן."

msgid "Make sure your headphones are turned on and paired with this computer, then refresh."
msgstr "ודא שהאוזניות דולקות ומותאמות למחשב הזה, ואז רענן."

msgid "Simulated device data"
msgstr "נתוני מכשיר מדומים"

msgid "Paired in Windows · looks like the chosen model"
msgstr "מותאם ב-Windows · נראה כמו הדגם שנבחר"

msgid "Paired with this computer · looks like the chosen model"
msgstr "מותאם למחשב הזה · נראה כמו הדגם שנבחר"

msgid "Paired in Windows"
msgstr "מותאם ב-Windows"

msgid "Paired with this computer"
msgstr "מותאם למחשב הזה"

msgid "Could not add the device."
msgstr "לא ניתן להוסיף את המכשיר."

msgid "Demo mode uses simulated device data and does not control real headphones."
msgstr "מצב הדגמה משתמש בנתונים מדומים ואינו שולט באוזניות אמיתיות."

msgid "Back"
msgstr "חזרה"

# Section pages
msgid "Mode and strength"
msgstr "מצב ועוצמה"

msgid "Sound mode from 1 to 11"
msgstr "מצב צליל מ-1 עד 11"

msgid "Transparency, strength {}"
msgstr "שקיפות, עוצמה {}"

msgid "Noise canceling, strength {}"
msgstr "סינון רעשים, עוצמה {}"

msgid "Your strength is remembered."
msgstr "העוצמה שלך נשמרת."

msgid "Back in noise canceling or transparency, the last strength of that mode is used."
msgstr "בחזרה לסינון רעשים או לשקיפות, נעשה שימוש בעוצמה האחרונה של אותו מצב."

msgid "Lowers the noise around you."
msgstr "מנמיך את הרעש סביבך."

msgid "Keeps the sounds around you audible."
msgstr "משאיר את הצלילים סביבך נשמעים."

msgid "No processing of ambient sound."
msgstr "ללא עיבוד של צליל הסביבה."

msgid "Single press"
msgstr "נגיעה אחת"

msgid "Double press"
msgstr "נגיעה כפולה"

msgid "Triple press"
msgstr "נגיעה משולשת"

msgid "Long press"
msgstr "לחיצה ארוכה"

msgid "Slide up"
msgstr "החלקה למעלה"

msgid "Slide down"
msgstr "החלקה למטה"

msgid "Noise canceling"
msgstr "סינון רעשים"

msgid "Transparency"
msgstr "שקיפות"

msgid "Normal"
msgstr "רגיל"

msgid "Noise canceling strength"
msgstr "עוצמת סינון הרעשים"

msgid "Transparency strength"
msgstr "עוצמת השקיפות"

msgid "Airplane mode updates"
msgstr "עדכוני מצב טיסה"

msgid "Lowers wind noise in the microphones"
msgstr "מנמיך רעשי רוח במיקרופונים"

msgid "Pause automatically when you remove an earbud"
msgstr "השהיה אוטומטית כשמוציאים אוזנייה"

msgid "Lower the music while you talk"
msgstr "הנמכת המוזיקה בזמן שאתה מדבר"

msgid "When the music comes back after you stop talking"
msgstr "מתי המוזיקה חוזרת אחרי שהפסקת לדבר"

msgid "Keeps the sound full when an earbud sits loosely"
msgstr "שומר על צליל מלא כשאוזנייה יושבת רופפת"

msgid "Limit the volume of your earbuds"
msgstr "הגבלת עוצמת השמע של האוזניות"

msgid "Limit the volume of your speaker"
msgstr "הגבלת עוצמת השמע של הרמקול"

msgid "Volume of the speaker"
msgstr "עוצמת השמע של הרמקול"

msgid "High-quality sound over Bluetooth"
msgstr "צליל באיכות גבוהה דרך Bluetooth"

msgid "A wider sound stage for music and video"
msgstr "במת צליל רחבה יותר למוזיקה ולווידאו"

msgid "Connect to up to two devices at once"
msgstr "חיבור לעד שני מכשירים בבת אחת"

msgid "When the device is not in use"
msgstr "כשהמכשיר לא בשימוש"

msgid "A voice prompt when the battery runs low"
msgstr "הודעה קולית כשהסוללה עומדת להיגמר"

msgid "Voice messages about modes and connections"
msgstr "הודעות קוליות על מצבים וחיבורים"

msgid "Turn the speaker off now"
msgstr "כבה את הרמקול עכשיו"

msgid "Show this function on the case screen"
msgstr "הצג פונקציה זו במסך הקייס"

msgid "Independent of the app language"
msgstr "בלתי תלויה בשפת האפליקציה"

msgid "Bring back what the buttons did out of the box"
msgstr "להחזיר את פעולות הכפתורים המקוריות"

msgid "dB"
msgstr "dB"

msgid "Copy"
msgstr "העתק"

msgid "Copied"
msgstr "הועתק"

msgid "Reset"
msgstr "איפוס"

msgid "Turn off"
msgstr "כבה"

msgid "No paired devices reported by your earbuds."
msgstr "האוזניות לא מדווחות על מכשירים מותאמים."

msgid "Volume"
msgstr "עוצמת שמע"

msgid "Presses"
msgstr "נגיעות"

msgid "Switching modes"
msgstr "החלפת מצבים"

msgid "Case screen"
msgstr "מסך הקייס"

msgid "Status"
msgstr "מצב"

msgid "Connected devices"
msgstr "מכשירים מחוברים"

msgid "The modes the ambient sound mode action switches between."
msgstr "המצבים שביניהם מחליפה הפעולה של מצב צליל הסביבה."

msgid "The earbud volume limit does not replace guidance on safe listening duration."
msgstr "הגבלת עוצמת השמע של האוזניות אינה מחליפה הנחיות לגבי משך האזנה בטוח."

msgid "The speaker’s volume limit does not replace guidance on safe listening duration."
msgstr "הגבלת עוצמת השמע של הרמקול אינה מחליפה הנחיות לגבי משך האזנה בטוח."

msgid "This list shows devices paired with your earbuds, not nearby Bluetooth devices. Forgetting this computer ends control of the earbuds."
msgstr "ברשימה זו מכשירים שמותאמים לאוזניות שלך, לא מכשירי Bluetooth בסביבה. שכחת המחשב הזה מסיימת את השליטה באוזניות."

msgid "Left earbud"
msgstr "אוזנייה שמאלית"

msgid "Right earbud"
msgstr "אוזנייה ימנית"

msgid "Earbud"
msgstr "אוזנייה"

msgid "Left"
msgstr "שמאל"

msgid "Right"
msgstr "ימין"

msgid "Actions for the chosen earbud."
msgstr "פעולות לאוזנייה שנבחרה."

msgid "Actions of the buttons on the device."
msgstr "פעולות הכפתורים במכשיר."

msgid "The device carries out these actions itself. Windows media keys work as usual."
msgstr "המכשיר מבצע את הפעולות האלה בעצמו. מקשי המדיה של Windows עובדים כרגיל."

msgid "The device carries out these actions itself. Media keys work as usual."
msgstr "המכשיר מבצע את הפעולות האלה בעצמו. מקשי המדיה עובדים כרגיל."

msgid "Small details. More comfort."
msgstr "פרטים קטנים. יותר נוחות."

msgid "Let your earbuds adapt to you."
msgstr "תן לאוזניות להתאים את עצמן אליך."

msgid "Let your speaker adapt to you."
msgstr "תן לרמקול להתאים את עצמו אליך."

msgid "These settings are stored in the device and work with any sound source."
msgstr "הגדרות אלה נשמרות במכשיר ופועלות עם כל מקור צליל."

msgid "Auto power off works while the device plays no sound."
msgstr "הכיבוי האוטומטי פועל כשהמכשיר לא מנגן."

msgid "Bluetooth and devices"
msgstr "Bluetooth ומכשירים"

msgid "Pairing and removing devices"
msgstr "התאמה והסרה של מכשירים"

msgid "Output device and volume"
msgstr "התקן פלט ועוצמת שמע"

msgid "Windows plays sound without LDAC. The setting is for your phone and other sources with LDAC."
msgstr "Windows מנגן צליל בלי LDAC. ההגדרה מיועדת לטלפון ולמקורות אחרים עם LDAC."

msgid "On Liberty 4 Pro, changing the equalizer turns off spatial audio. You can turn it on again here."
msgstr "ב-Liberty 4 Pro, שינוי האיקוולייזר מכבה את השמע המרחבי. אפשר להפעיל אותו שוב כאן."

msgid "Choose the features available on your case screen. The case language is independent of the app language."
msgstr "בחר את הפונקציות שזמינות במסך הקייס. שפת הקייס אינה תלויה בשפת האפליקציה."

msgid "The device reports these itself and keeps them up to date."
msgstr "המכשיר מדווח על הנתונים האלה בעצמו ושומר אותם מעודכנים."

msgid "The serial number and firmware version help when you contact support."
msgstr "המספר הסידורי וגרסת הקושחה עוזרים כשפונים לתמיכה."

