# Slogans and descriptions, as in the Android app
msgid "Hear what matters."
msgstr "যা জরুরি, তা শুনুন।"

msgid "Your sound, your way."
msgstr "আপনার সাউন্ড, আপনার মতো।"

msgid "Inside the sound."
msgstr "সাউন্ডের ভেতরে।"

msgid "One preset. Your settings."
msgstr "একটি প্রিসেট। আপনার সেটিংস।"

msgid "A touch. And you’re in control."
msgstr "একটি স্পর্শ। নিয়ন্ত্রণ আপনার হাতে।"

msgid "Comfortable listening. Every day."
msgstr "আরামদায়ক শোনা। প্রতিদিন।"

msgid "Always ready."
msgstr "সবসময় প্রস্তুত।"

msgid "Stay connected. To two at once."
msgstr "সংযুক্ত থাকুন। একসাথে দুটির সাথে।"

msgid "A little case. More possibilities."
msgstr "ছোট্ট কেস। আরও সম্ভাবনা।"

msgid "All about your device."
msgstr "আপনার ডিভাইসের সবকিছু।"

msgid "Your devices."
msgstr "আপনার ডিভাইসগুলো।"

msgid "Make it yours."
msgstr "আপনার রুচি অনুযায়ী।"

msgid "Choose how much of the world to let into your sound."
msgstr "আপনার সাউন্ডে বাইরের পৃথিবীর কতটা ঢুকবে, বেছে নিন।"

msgid "Pick a profile or tune every frequency."
msgstr "একটি প্রোফাইল বেছে নিন বা প্রতিটি ফ্রিকোয়েন্সি সমন্বয় করুন।"

msgid "Codec, latency and how the sound is processed."
msgstr "কোডেক, লেটেন্সি এবং সাউন্ড কীভাবে প্রক্রিয়া করা হয়।"

msgid "Save your favourite combinations and return to them with a click."
msgstr "পছন্দের সমন্বয়গুলো সংরক্ষণ করুন এবং এক ক্লিকে ফিরে আসুন।"

msgid "What presses do, and which modes they switch between."
msgstr "ট্যাপ কী করে এবং কোন মোডগুলোর মধ্যে বদলায়।"

msgid "Settings that adapt your earbuds to your habits."
msgstr "যে সেটিংস আপনার ইয়ারবাডকে আপনার অভ্যাসের সাথে মানিয়ে নেয়।"

msgid "Settings that adapt your speaker to your habits."
msgstr "যে সেটিংস আপনার স্পিকারকে আপনার অভ্যাসের সাথে মানিয়ে নেয়।"

msgid "When the device turns off and what it tells you."
msgstr "ডিভাইস কখন বন্ধ হয় এবং আপনাকে কী জানায়।"

msgid "Switch between your phone and computer."
msgstr "ফোন আর কম্পিউটারের মধ্যে বদল করুন।"

msgid "The case screen’s features and how the case is doing."
msgstr "কেসের স্ক্রিনের ফাংশন এবং কেসের অবস্থা।"

msgid "Battery, firmware and serial numbers."
msgstr "ব্যাটারি, ফার্মওয়্যার এবং সিরিয়াল নম্বর।"

msgid "All your familiar headphones in one place."
msgstr "আপনার পরিচিত সব হেডফোন এক জায়গায়।"

msgid "An app that feels comfortable to use."
msgstr "ব্যবহারে আরামদায়ক একটি অ্যাপ।"

# Connection
msgid "No devices"
msgstr "কোনো ডিভাইস নেই"

msgid "Add a device"
msgstr "ডিভাইস যোগ করুন"

msgid "Connected"
msgstr "সংযুক্ত"

msgid "Connecting…"
msgstr "সংযোগ হচ্ছে…"

msgid "Not connected"
msgstr "সংযুক্ত নয়"

msgid "Connected to {}"
msgstr "{}-এর সাথে সংযুক্ত"

msgid "Connecting to {}"
msgstr "{}-এর সাথে সংযোগ হচ্ছে"

msgid "Reconnecting:"
msgstr "পুনরায় সংযোগ:"

msgid "Reconnecting to {}"
msgstr "{} এর সাথে পুনরায় সংযোগ"

msgid "The device is still nearby. Settings will return when it reconnects."
msgstr "ডিভাইসটি কাছেই আছে। পুনরায় সংযোগ হলে সেটিংস ফিরে আসবে।"

msgid "changes are paused until the device is back."
msgstr "ডিভাইস ফিরে না আসা পর্যন্ত পরিবর্তনগুলি বিরত আছে।"

msgid "Connection lost"
msgstr "সংযোগ বিচ্ছিন্ন হয়েছে"

msgid "Bluetooth is off"
msgstr "ব্লুটুথ বন্ধ"

msgid "Disconnected"
msgstr "সংযোগ বিচ্ছিন্ন"

msgid "Connecting to your headphones"
msgstr "আপনার হেডফোনের সাথে সংযোগ হচ্ছে"

msgid "Connecting to your speaker"
msgstr "আপনার স্পিকারের সাথে সংযোগ হচ্ছে"

msgid "Could not connect"
msgstr "সংযোগ করা যায়নি"

msgid "{} is not connected"
msgstr "{} সংযুক্ত নয়"

msgid "Open the case or turn on your headphones. Controls will appear once connected."
msgstr "কেস খুলুন বা হেডফোন চালু করুন। সংযোগের পরে নিয়ন্ত্রণগুলো দেখা যাবে।"

msgid "Turn on your speaker. Controls will appear once connected."
msgstr "স্পিকার চালু করুন। সংযোগের পরে নিয়ন্ত্রণগুলো দেখা যাবে।"

msgid "Check that your headphones are nearby and connected to this computer by Bluetooth."
msgstr "হেডফোন কাছেই আছে এবং ব্লুটুথে এই কম্পিউটারের সাথে সংযুক্ত কি না দেখুন।"

msgid "Check that your speaker is nearby and connected to this computer by Bluetooth."
msgstr "স্পিকার কাছেই আছে এবং ব্লুটুথে এই কম্পিউটারের সাথে সংযুক্ত কি না দেখুন।"

msgid "Turn on Bluetooth in Windows settings, then try connecting again."
msgstr "Windows সেটিংসে ব্লুটুথ চালু করুন, তারপর আবার সংযোগের চেষ্টা করুন।"

msgid "Turn on Bluetooth in the system settings, then try connecting again."
msgstr "সিস্টেম সেটিংসে ব্লুটুথ চালু করুন, তারপর আবার সংযোগের চেষ্টা করুন।"

msgid "Connect to see battery levels and change settings."
msgstr "ব্যাটারি দেখতে এবং সেটিংস বদলাতে সংযোগ করুন।"

msgid "The device was not found. Make sure it is turned on and nearby."
msgstr "ডিভাইসটি পাওয়া যায়নি। এটি চালু এবং কাছে আছে কি না নিশ্চিত করুন।"

msgid "The device did not answer in time. Try again."
msgstr "ডিভাইস সময়মতো সাড়া দেয়নি। আবার চেষ্টা করুন।"

msgid "Cancel"
msgstr "বাতিল"

msgid "Connect"
msgstr "সংযোগ করুন"

msgid "Connect again"
msgstr "আবার সংযোগ করুন"

msgid "Bluetooth settings"
msgstr "ব্লুটুথ সেটিংস"

msgid "Could not change “{}”. The device kept its previous value."
msgstr "“{}” বদলানো যায়নি। ডিভাইস আগের মান রেখেছে।"

msgid "Retry"
msgstr "আবার চেষ্টা করুন"

msgid "Close"
msgstr "বন্ধ করুন"

# My devices
msgid "Open"
msgstr "খুলুন"

msgid "Forget device"
msgstr "ডিভাইস ভুলে যান"

msgid "Demo device · Not connected"
msgstr "ডেমো ডিভাইস · সংযুক্ত নয়"

msgid "Saved device · Not connected"
msgstr "সংরক্ষিত ডিভাইস · সংযুক্ত নয়"

msgid "Add device"
msgstr "ডিভাইস যোগ করুন"

msgid "A model, then its paired device"
msgstr "প্রথমে মডেল, তারপর জোড়া লাগানো ডিভাইস"

msgid "Your sound starts here."
msgstr "আপনার সাউন্ড এখান থেকে শুরু।"

msgid "Add your headphones to adjust sound and controls."
msgstr "সাউন্ড ও নিয়ন্ত্রণ সমন্বয় করতে আপনার হেডফোন যোগ করুন।"

msgid "Forget {}?"
msgstr "{} ভুলে যাবেন?"

msgid "The device leaves this list together with its profiles and presets in the app. Its pairing with Windows stays."
msgstr "ডিভাইসটি অ্যাপে এর প্রোফাইল ও প্রিসেটসহ এই তালিকা থেকে সরে যাবে। Windows-এর সাথে জোড়া থেকে যাবে।"

msgid "The device leaves this list together with its profiles and presets in the app. Its pairing with this computer stays."
msgstr "ডিভাইসটি অ্যাপে এর প্রোফাইল ও প্রিসেটসহ এই তালিকা থেকে সরে যাবে। এই কম্পিউটারের সাথে জোড়া থেকে যাবে।"

msgid "Forget"
msgstr "ভুলে যান"

# Adding a device
msgid "Find your model."
msgstr "আপনার মডেল খুঁজুন।"

msgid "Choose the exact model so you see the controls your device supports."
msgstr "সঠিক মডেল বেছে নিন, যাতে আপনার ডিভাইস যে সেটিংস সমর্থন করে তা দেখতে পান।"

msgid "Model name or code, such as A3954"
msgstr "মডেলের নাম বা কোড, যেমন A3954"

msgid "All"
msgstr "সব"

msgid "Earbuds"
msgstr "ইয়ারবাড"

msgid "Over-ear"
msgstr "ওভার-ইয়ার"

msgid "Open-ear"
msgstr "ওপেন-ইয়ার"

msgid "Speakers"
msgstr "স্পিকার"

msgid "No models found. Try another name or code."
msgstr "কোনো মডেল পাওয়া যায়নি। অন্য নাম বা কোড চেষ্টা করুন।"

msgid "Ready to connect your headphones?"
msgstr "হেডফোন সংযোগের জন্য প্রস্তুত?"

msgid "Ready to connect your speaker?"
msgstr "স্পিকার সংযোগের জন্য প্রস্তুত?"

msgid "Choose the device paired with Windows. If it is not listed, pair it in Bluetooth settings first."
msgstr "Windows-এর সাথে জোড়া লাগানো ডিভাইসটি বেছে নিন। তালিকায় না থাকলে আগে ব্লুটুথ সেটিংসে জোড়া লাগান।"

msgid "Choose the device paired with this computer. If it is not listed, pair it in Bluetooth settings first."
msgstr "এই কম্পিউটারের সাথে জোড়া লাগানো ডিভাইসটি বেছে নিন। তালিকায় না থাকলে আগে ব্লুটুথ সেটিংসে জোড়া লাগান।"

msgid "Another model"
msgstr "অন্য মডেল"

msgid "Demo mode"
msgstr "ডেমো মোড"

msgid "Explore the interface without real headphones"
msgstr "আসল হেডফোন ছাড়াই ইন্টারফেস ঘুরে দেখুন"

msgid "Paired devices"
msgstr "জোড়া লাগানো ডিভাইস"

msgid "Refresh"
msgstr "রিফ্রেশ করুন"

msgid "Bluetooth is off. Turn it on in Windows settings."
msgstr "ব্লুটুথ বন্ধ। Windows সেটিংসে এটি চালু করুন।"

msgid "Bluetooth is off. Turn it on in the system settings."
msgstr "ব্লুটুথ বন্ধ। সিস্টেম সেটিংসে এটি চালু করুন।"

msgid "Looking for paired devices…"
msgstr "জোড়া লাগানো ডিভাইস খোঁজা হচ্ছে…"

msgid "Make sure your headphones are turned on and paired with Windows, then refresh."
msgstr "হেডফোন চালু এবং Windows-এর সাথে জোড়া লাগানো আছে কি না নিশ্চিত করুন, তারপর রিফ্রেশ করুন।"

msgid "Make sure your headphones are turned on and paired with this computer, then refresh."
msgstr "হেডফোন চালু এবং এই কম্পিউটারের সাথে জোড়া লাগানো আছে কি না নিশ্চিত করুন, তারপর রিফ্রেশ করুন।"

msgid "Simulated device data"
msgstr "সিমুলেটেড ডিভাইস ডেটা"

msgid "Paired in Windows · looks like the chosen model"
msgstr "Windows-এ জোড়া লাগানো · বেছে নেওয়া মডেলের মতো"

msgid "Paired with this computer · looks like the chosen model"
msgstr "এই কম্পিউটারের সাথে জোড়া লাগানো · বেছে নেওয়া মডেলের মতো"

msgid "Paired in Windows"
msgstr "Windows-এ জোড়া লাগানো"

msgid "Paired with this computer"
msgstr "এই কম্পিউটারের সাথে জোড়া লাগানো"

msgid "Could not add the device."
msgstr "ডিভাইস যোগ করা যায়নি।"

msgid "Demo mode uses simulated device data and does not control real headphones."
msgstr "ডেমো মোড সিমুলেটেড ডেটা ব্যবহার করে এবং আসল হেডফোন নিয়ন্ত্রণ করে না।"

msgid "Back"
msgstr "পেছনে"

# Section pages
msgid "Mode and strength"
msgstr "মোড ও শক্তি"

msgid "Sound mode from 1 to 11"
msgstr "১ থেকে ১১ পর্যন্ত সাউন্ড মোড"

msgid "Transparency, strength {}"
msgstr "স্বচ্ছতা, শক্তি {}"

msgid "Noise canceling, strength {}"
msgstr "নয়েজ ক্যান্সেলিং, শক্তি {}"

msgid "Your strength is remembered."
msgstr "আপনার বেছে নেওয়া শক্তি মনে রাখা হয়।"

msgid "Back in noise canceling or transparency, the last strength of that mode is used."
msgstr "নয়েজ ক্যান্সেলিং বা স্বচ্ছতায় ফিরলে সেই মোডের শেষ শক্তি ব্যবহার হয়।"

msgid "Lowers the noise around you."
msgstr "চারপাশের শব্দ কমায়।"

msgid "Keeps the sounds around you audible."
msgstr "চারপাশের শব্দ শোনা যায় রাখে।"

msgid "No processing of ambient sound."
msgstr "পারিপার্শ্বিক শব্দ প্রক্রিয়া করা হয় না।"

msgid "Single press"
msgstr "একবার ট্যাপ"

msgid "Double press"
msgstr "দুবার ট্যাপ"

msgid "Triple press"
msgstr "তিনবার ট্যাপ"

msgid "Long press"
msgstr "দীর্ঘ চাপ"

msgid "Slide up"
msgstr "উপরে সোয়াইপ"

msgid "Slide down"
msgstr "নিচে সোয়াইপ"

msgid "Noise canceling"
msgstr "নয়েজ ক্যান্সেলিং"

msgid "Transparency"
msgstr "স্বচ্ছতা"

msgid "Normal"
msgstr "স্বাভাবিক"

msgid "Noise canceling strength"
msgstr "নয়েজ ক্যান্সেলিংয়ের শক্তি"

msgid "Transparency strength"
