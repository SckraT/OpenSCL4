msgstr "기기 화면 편집"

msgid "Only one earbud is connected. The equalizer and some other settings become available when both earbuds are connected."
msgstr "이어폰이 하나만 연결되어 있습니다. 이퀄라이저 등 일부 설정은 양쪽 이어폰이 연결되면 사용할 수 있습니다."

msgid "Move up"
msgstr "위로 이동"

msgid "Move down"
msgstr "아래로 이동"

msgid "Your device screen."
msgstr "내 기기 화면."

msgid "Turn on the blocks you use and move them up or down to change the order."
msgstr "사용하는 블록을 켜고 위아래로 옮겨 순서를 바꾸세요."

msgid "Ready-made sets"
msgstr "기본 구성"

msgid "Minimal"
msgstr "최소"

msgid "Standard"
msgstr "표준"

msgid "Full"
msgstr "전체"

msgid "Done"
