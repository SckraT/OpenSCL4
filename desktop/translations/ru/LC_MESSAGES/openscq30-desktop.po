msgid "{} Hz"
msgstr "{} Гц"

msgid "{} kHz"
msgstr "{} кГц"

msgid "{}, dB"
msgstr "{}, дБ"

msgid "Equalizer bands: {}"
msgstr "Полосы эквалайзера: {}"

