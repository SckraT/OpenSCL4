# Sidebar and page names
msgid "Overview"
msgstr "Обзор"

msgid "Sound mode"
msgstr "Режим звука"

msgid "Equalizer"
msgstr "Эквалайзер"

msgid "Sound and effects"
msgstr "Звук и эффекты"

msgid "Quick presets"
msgstr "Быстрые пресеты"

msgid "Controls"
msgstr "Управление"

msgid "Comfort"
msgstr "Комфорт"

msgid "Power and prompts"
msgstr "Питание и подсказки"

