msgstr "Подключения"

msgid "Case"
msgstr "Кейс"

msgid "About the device"
msgstr "Об устройстве"

msgid "Sleep"
msgstr "Сон"

msgid "Lights"
msgstr "Подсветка"

msgid "Alarms"
msgstr "Будильники"

msgid "Other"
msgstr "Прочее"

