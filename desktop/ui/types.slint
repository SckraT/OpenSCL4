// What the window shows and what it can ask for. Rust (src/lib.rs, src/view.rs) fills AppState and answers Actions.

export enum Page {
    overview,
    sound-modes,
    equalizer,
    effects,
    presets,
    controls,
    comfort,
    power,
    connections,
    case,
    about,
    sleep,
    lights,
    alarms,
    other,
    devices,
    settings,
}

export enum Connection { no-device, off, connecting, connected, lost, bluetooth-off, failed }

export enum FailureKind { none, not-found, timed-out, other }

// short messages at the bottom of the window
export enum ToastKind { none, copied }

export struct DeviceCard {
    mac: string,
    name: string,
    code: string,
    art: image,
    current: bool,
    demo: bool,
}

// 1 earbuds, 2 over-ear headphones, 3 open earbuds, 4 speakers
export struct ModelOption {
    code: string,
    name: string,
    art: image,
}

// a setting as a row: what kind of control it gets, and its value in that kind's terms
export enum RowKind { toggle, select, range, info, action, list, hue, time }

export struct SettingRow {
    id: string,
    kind: RowKind,
    label: string,
    enabled: bool,
    checked: bool,
    // a select's options, or a list's items
    options: [string],
    index: int,
    minimum: int,
    maximum: int,
    step: int,
    value: int,
    text: string,
}

export enum PanelKind { plain, volume, gestures, presses, cycle, reset, case-screen, case-status, info, dual-devices, power-off }

export struct SettingsPanel {
    kind: PanelKind,
    rows: [SettingRow],
}

export struct ModeOption {
    value: string,
    label: string,
}

export struct PairedOption {
    mac: string,
    name: string,
    suggested: bool,
}

export global AppState {
    in-out property <Page> page: Page.devices;
    // the pages of the connected device, under "Sound" and "Device" in the sidebar
    in property <[Page]> sound-pages;
    in property <[Page]> device-pages;

    in property <Connection> connection: Connection.no-device;
    in property <string> device-name;
    in property <string> device-code;
    in property <image> device-art;
    in property <bool> device-is-speaker;
    in property <bool> one-earbud;
    in property <FailureKind> failure-kind;
    // the library's own words, for failures the window has no name for
    in property <string> failure-text;

    in property <[DeviceCard]> devices;

    // adding a device: a model, then the paired device that is it
    in-out property <bool> adding;
    in-out property <int> add-step;
    in property <[ModelOption]> models;
    in-out property <string> model-query;
    in-out property <int> model-kind;
    in property <string> add-model-name;
    in property <string> add-model-code;
    in property <image> add-model-art;
    in property <bool> add-model-is-speaker;
    in-out property <bool> add-demo;
    in property <bool> add-loading;
    in property <[PairedOption]> paired-options;
    in property <FailureKind> add-failure-kind;
    in property <string> add-error;
    in property <bool> add-bluetooth-off;

    // the current page's settings
    in property <[SettingsPanel]> panels;
    in-out property <string> controls-side: "left";
    in property <bool> has-sides;

    // the sound mode: tiles, or the 1 to 11 scale
    in property <[ModeOption]> modes;
    in property <int> mode-index: -1;
    in property <bool> mode-scale;
    in property <int> scale-position;
    in property <[SettingRow]> mode-rows;
    in property <string> normal-label;
    in property <string> transparency-label;
    in property <string> noise-canceling-label;
    in property <string> airplane-label;
    in property <int> airplane-index: -1;

    // what the asides of the section pages show
    in property <bool> has-ldac;
    in property <bool> has-spatial;
    in property <string> case-battery;

    // a change the device did not take, shown above the page
    in property <string> error-label;
    in property <ToastKind> toast;

    // asking before forgetting
    in-out property <string> confirm-forget-mac;
    in-out property <string> confirm-forget-name;
}

export global Actions {
    callback navigate(Page);
    callback connect(string);
    callback cancel-connect();
    callback disconnect();
    callback forget(string);
    callback open-add-device();
    callback filter-models(string, int);
    callback choose-model(string);
    callback set-demo(bool);
    callback refresh-paired();
    callback pair(string, string);
    callback retry();
    callback dismiss-error();
    callback open-uri(string);
    callback set-toggle(string, bool);
    callback set-option(string, int);
    callback set-number(string, int);
    callback press(string);
    callback remove-item(string, int);
    callback set-scale(int);
    callback set-side(string);
    callback copy(string);
}
