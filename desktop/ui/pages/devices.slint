// My devices: the saved devices, adding one, and what is shown while no device is connected.
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { AppState, Actions, Page, Connection, DeviceCard, FailureKind, SystemPage } from "../types.slint";

// what went wrong, in words
export global FailureText {
    public pure function describe(kind: FailureKind, details: string) -> string {
        if kind == FailureKind.not-found { return @tr("The device was not found. Make sure it is turned on and nearby."); }
        if kind == FailureKind.timed-out { return @tr("The device did not answer in time. Try again."); }
        return details;
    }
}
import { Icon, Button, ButtonKind, IconButton } from "../components/basics.slint";
import { PageHeading } from "../shell.slint";

component DeviceCardView inherits Rectangle {
    in property <DeviceCard> card;
    private property <bool> live: card.current && AppState.connection == Connection.connected;
    private property <bool> connecting: card.current && AppState.connection == Connection.connecting;
    private property <bool> recovering: card.current && AppState.connection == Connection.recovering;
    border-radius: Theme.radius-panel;
    background: live ? Theme.sage : Theme.surface;
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: "SOUNDCORE · " + root.card.code;
                color: root.live ? Theme.on-sage : Theme.muted;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.4px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: Icons.trash;
                label: @tr("Forget device");
                tint: root.live ? Theme.on-sage : Theme.muted;
                clicked => {
                    AppState.confirm-forget-mac = root.card.mac;
                    AppState.confirm-forget-name = root.card.name;
                }
            }
        }
        Image {
            source: root.card.art;
            height: 140px;
            image-fit: contain;
        }
        Text {
            text: root.card.name;
            color: root.live ? Theme.on-sage : Theme.text;
            font-size: 20px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.live ? @tr("Connected") : root.connecting ? @tr("Connecting…")
                : root.card.demo ? @tr("Demo device · Not connected") : @tr("Saved device · Not connected");
            color: root.live ? Theme.on-sage : Theme.muted;
            font-size: Theme.font-caption;
        }
        Rectangle { vertical-stretch: 1; }
        if root.live: Button {
            text: @tr("Open");
            kind: ButtonKind.primary;
            has-icon: true;
            icon: Icons.chevron;
            clicked => { Actions.navigate(Page.overview); }
        }
        if !root.live: Button {
            text: root.connecting ? @tr("Connecting…") : @tr("Connect");
            enabled: !root.connecting;
            has-icon: true;
            icon: Icons.bluetooth;
            clicked => { Actions.connect(root.card.mac); }
        }
    }
}

component AddCard inherits Rectangle {
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.line;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: @tr("Add device");
    accessible-action-default => { Actions.open-add-device(); }
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: Icons.plus;
                tint: Theme.primary;
                width: 30px;
                height: 30px;
            }
        }
        Text {
            text: @tr("Add device");
            color: Theme.primary;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("A model, then its paired device");
            color: Theme.muted;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Actions.open-add-device(); }
    }
}

export component EmptyDevices inherits VerticalLayout {
    alignment: center;
    spacing: 12px;
    padding: 60px;
    HorizontalLayout {
        alignment: center;
        Icon {
            source: Icons.headphones;
            tint: Theme.primary;
            width: 56px;
            height: 56px;
        }
    }
    Text {
        text: @tr("Your sound starts here.");
        color: Theme.text;
        font-size: 24px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: @tr("Add your headphones to adjust sound and controls.");
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: @tr("Add device");
            kind: ButtonKind.primary;
            has-icon: true;
            icon: Icons.plus;
            clicked => { Actions.open-add-device(); }
        }
    }
}

export component DevicesPage inherits VerticalLayout {
    PageHeading {
        page: Page.devices;
        if AppState.devices.length > 0: Button {
            text: @tr("Add device");
            kind: ButtonKind.primary;
            has-icon: true;
            icon: Icons.plus;
            clicked => { Actions.open-add-device(); }
        }
    }
    if AppState.devices.length == 0: EmptyDevices { }
    if AppState.devices.length > 0: grid := Rectangle {
        private property <length> gap: 18px;
        private property <int> columns: max(1, floor((self.width + gap) / 270px));
        private property <length> cell-width: (self.width - (columns - 1) * gap) / columns;
        private property <length> cell-height: 340px;
        height: ceil((AppState.devices.length + 1) / columns) * (cell-height + gap) - gap;
        for card[index] in AppState.devices: DeviceCardView {
            card: card;
            x: mod(index, grid.columns) * (grid.cell-width + grid.gap);
            y: floor(index / grid.columns) * (grid.cell-height + grid.gap);
            width: grid.cell-width;
            height: grid.cell-height;
        }
        AddCard {
            x: mod(AppState.devices.length, grid.columns) * (grid.cell-width + grid.gap);
            y: floor(AppState.devices.length / grid.columns) * (grid.cell-height + grid.gap);
            width: grid.cell-width;
            height: grid.cell-height;
        }
    }
}

// Shown on a device's pages while it is not connected.
export component ConnectionState inherits VerticalLayout {
    alignment: center;
    spacing: 14px;
    padding: 60px;
    private property <bool> speaker: AppState.device-is-speaker;
    if AppState.connection == Connection.connecting || AppState.connection == Connection.recovering: Rectangle {
        height: 44px;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            border-width: 3px;
            border-color: Theme.primary;
            opacity: 0.6;
        }
    }
    if AppState.connection != Connection.connecting && AppState.connection != Connection.recovering: HorizontalLayout {
        alignment: center;
        Icon {
            source: AppState.connection == Connection.bluetooth-off ? Icons.bluetooth : Icons.disconnect;
            tint: Theme.primary;
            width: 64px;
            height: 64px;
        }
    }
    Text {
        horizontal-alignment: center;
        color: Theme.text;
        font-size: 28px;
        font-weight: 650;
        wrap: word-wrap;
        text: AppState.connection == Connection.recovering ? @tr("Reconnecting:")
            : AppState.connection == Connection.connecting ? (root.speaker ? @tr("Connecting to your speaker") : @tr("Connecting to your headphones"))
            : AppState.connection == Connection.lost ? @tr("Connection lost")
            : AppState.connection == Connection.bluetooth-off ? @tr("Bluetooth is off")
            : AppState.connection == Connection.failed ? @tr("Could not connect")
            : @tr("{} is not connected", AppState.device-name);
    }
    Text {
        horizontal-alignment: center;
        color: Theme.muted;
        wrap: word-wrap;
        text: AppState.connection == Connection.recovering ? (AppState.connection-reason == "" ? @tr("The device is still nearby. Settings will return when it reconnects.") : AppState.connection-reason)
            : AppState.connection == Connection.connecting ? (root.speaker ? @tr("Turn on your speaker. Controls will appear once connected.") : @tr("Open the case or turn on your headphones. Controls will appear once connected."))
            : AppState.connection == Connection.lost ? (root.speaker ? @tr("Check that your speaker is nearby and connected to this computer by Bluetooth.") : @tr("Check that your headphones are nearby and connected to this computer by Bluetooth."))
            : AppState.connection == Connection.bluetooth-off ? (AppState.linux ? @tr("Turn on Bluetooth in the system settings, then try connecting again.") : @tr("Turn on Bluetooth in Windows settings, then try connecting again."))
            : AppState.connection == Connection.failed ? FailureText.describe(AppState.failure-kind, AppState.failure-text)
            : @tr("Connect to see battery levels and change settings.");
    }
    if AppState.connection == Connection.lost && AppState.connection-reason != "": Text {
        horizontal-alignment: center;
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
        text: AppState.connection-reason;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if AppState.connection == Connection.connecting || AppState.connection == Connection.recovering: Button {
            text: @tr("Cancel");
            clicked => { Actions.cancel-connect(); }
        }
        if AppState.connection == Connection.bluetooth-off && AppState.system-settings-available: Button {
            text: @tr("Bluetooth settings");
            kind: ButtonKind.primary;
            has-icon: true;
            icon: Icons.external;
            clicked => { Actions.open-system-settings(SystemPage.bluetooth); }
        }
        if AppState.connection != Connection.connecting && AppState.connection != Connection.recovering && AppState.connection != Connection.bluetooth-off: Button {
            text: AppState.connection == Connection.lost ? @tr("Connect again") : @tr("Connect");
            kind: ButtonKind.primary;
            has-icon: true;
            icon: Icons.bluetooth;
            clicked => { Actions.retry(); }
        }
        if AppState.connection != Connection.connecting && AppState.connection != Connection.recovering: Button {
            text: @tr("My devices");
            has-icon: true;
            icon: Icons.devices;
            clicked => { Actions.navigate(Page.devices); }
        }
    }
}
