import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "basics.slint";

export component Select inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index: -1;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int);
    private property <int> highlighted;
    private property <bool> popup-focused;
    private property <bool> focused: keys.has-focus || popup-focused;
    min-height: 40px;
    min-width: 160px;
    vertical-stretch: 0;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: focused ? Theme.primary : Theme.line;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    opacity: enabled ? 1 : 0.45;
    forward-focus: keys;
    accessible-role: combobox;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-value: model[current-index];
    accessible-expandable: enabled && model.length > 0;
    accessible-expanded: popup-focused;
    accessible-action-expand => { root.open(); }

    function open() {
        if !root.enabled || root.model.length == 0 { return; }
        root.highlighted = clamp(root.current-index, 0, root.model.length - 1);
        popup.show();
    }

    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.model.length {
            root.selected(index);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: root.model[root.current-index];
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            source: Icons.chevron-down;
            tint: Theme.primary;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
        }
    }

    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.open();
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.choose(clamp(root.current-index + (event.text == Key.DownArrow ? 1 : -1), 0, root.model.length - 1));
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.open(); }
        scroll-event(event) => {
            if !keys.has-focus || abs(event.delta-y) < 2px { return reject; }
            root.choose(clamp(root.current-index + (event.delta-y < 0px ? 1 : -1), 0, root.model.length - 1));
            accept
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, options.min-width + 14px);
        height: min(6, root.model.length) * 36px + 14px;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;
        Rectangle {
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.surface;
        }
        popup-keys := FocusScope {
            private property <int> highlighted: root.highlighted;
            changed highlighted => {
                let first = floor(-scroll.content-y / 36px);
                if root.highlighted < first {
                    scroll.content-y = -root.highlighted * 36px;
                } else if root.highlighted >= first + 6 {
                    scroll.content-y = -(root.highlighted - 5) * 36px;
                }
            }
            focus-changed-event => {
                root.popup-focused = self.has-focus;
                if self.has-focus { scroll.content-y = -max(0, root.highlighted - 5) * 36px; }
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    popup.close();
                    keys.focus();
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.choose(root.highlighted);
                    popup.close();
                    keys.focus();
                    return accept;
                }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    root.highlighted = clamp(root.highlighted + (event.text == Key.DownArrow ? 1 : -1), 0, root.model.length - 1);
                    return accept;
                }
                reject
            }
            scroll := ScrollView {
                x: 7px;
                y: 7px;
                width: parent.width - 14px;
                height: parent.height - 14px;
                content-y: -max(0, root.highlighted - 5) * 36px;
                options := VerticalLayout {
                    alignment: start;
                    for value[index] in root.model: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-chip;
                        background: option-touch.has-hover || index == root.highlighted ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: value;
                        accessible-checked: index == root.current-index;
                        accessible-action-default => {
                            root.choose(index);
                            popup.close();
                            keys.focus();
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text {
                                text: value;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Icon {
                                source: Icons.check;
                                tint: Theme.primary;
                                opacity: index == root.current-index ? 1 : 0;
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.choose(index);
                                popup.close();
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}
