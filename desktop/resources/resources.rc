icon ICON "com.oppzippy.OpenSCQ30.ico"
1 VERSIONINFO
FILEVERSION ${VERSION_MAJOR},${VERSION_MINOR},${VERSION_PATCH},0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SckraT"
            VALUE "FileDescription", "OpenSCL4"
            VALUE "FileVersion", "${VERSION}"
            VALUE "InternalName", "openscl4"
            VALUE "OriginalFilename", "openscl4.exe"
            VALUE "ProductName", "OpenSCL4"
            VALUE "ProductVersion", "${VERSION}"
            VALUE "LegalCopyright", "(C) Kyle Scheuing"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
